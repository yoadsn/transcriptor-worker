# Source storage (local)
SOURCE_STORAGE_TYPE="local"
SOURCE_STORAGE_PATH="data/uploads"

# Source storage (s3)
# SOURCE_STORAGE_TYPE="s3"
# SOURCE_STORAGE_PATH="s3://from-bucket"
# SOURCE_AWS_ACCESS_KEY_ID=FAKE
# SOURCE_AWS_SECRET_ACCESS_KEY=FAKE
# SOURCE_AWS_REGION="eu-north-1"

# Target storage (local)
TARGET_STORAGE_TYPE="local"
TARGET_STORAGE_PATH="data/output"

# Target storage (s3)
# TARGET_STORAGE_TYPE="s3"
# TARGET_STORAGE_PATH="s3://to-bucket"
# TARGET_AWS_ACCESS_KEY_ID=FAKE
# TARGET_AWS_SECRET_ACCESS_KEY=FAKE
# TARGET_AWS_REGION="eu-north-1"

# Worker settings
WORKER_PARALLELISM=1           # positive integer, default: 4
#MAX_SUBMISSIONS=              # positive integer; limits submissions processed per run (testing/debugging only — omit for no limit)
#FORCE_REPROCESS=true          # set to "true"/"1"/"yes" to reprocess already-completed submissions

# Surya detection thresholds (optional, leave empty to use library defaults)
#DETECTOR_TEXT_THRESHOLD=      # float, e.g. 0.5
#DETECTOR_BLANK_THRESHOLD=     # float, e.g. 0.1

# Temp directory for page images during a run (optional, defaults to system temp)
#TEMP_DIR=
